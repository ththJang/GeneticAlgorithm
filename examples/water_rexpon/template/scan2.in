#----Variable section----#
units                   real
boundary                p p p
special_bonds           lj/coul 1.0 1.0 1.0
atom_style              pqeq
#bond_style              harmonic
#angle_style             harmonic
read_data             data.scan2 
#read_restart            watbox.1300000.restart
timestep                1.0
pair_style     hybrid/overlay coul/pqeqgauss 0 12.0 0 reaxff/rexpon control bond 2 angle 2 vdw 1 hbond 1 nonreactive 1
pair_coeff * * reaxff/rexpon test.ffield.RexPoN H O
pair_coeff * * coul/pqeqgauss 0 0 0 0 0 0 0 0 # dummy
pair_coeff 1 1 coul/pqeqgauss 4.528 12.9841 0.371 1 1.0 0.371 2037.20061 0.0
pair_coeff 2 2 coul/pqeqgauss 8.741 13.364 0.669 1 1.0 0.669 414.04451 0.0

fix  pqeq all psq 1 1 3 1.0e-6 400

neighbor 15.0 bin

variable        sname index watbox
variable        targetT equal 230

#######################################################
compute                 pqeq all pair coul/pqeqgauss
compute                 reax all pair reaxff/rexpon
variable eb             equal c_reax[1]
variable ea             equal c_reax[2]
variable elp    equal c_reax[3]
variable emol   equal c_reax[4]
variable ev             equal c_reax[5]
variable epen   equal c_reax[6]
variable ecoa   equal c_reax[7]
variable ehb    equal c_reax[8]
variable et             equal c_reax[9]
variable eco    equal c_reax[10]
variable ew             equal c_reax[11]
variable epqeq  equal c_pqeq
########################################################

thermo 100
thermo_modify line multi

print                          .
print =====================================
print "NVT at 50K to 300K "
print =====================================
print            .

reset_timestep  0

#log             01WaterWater100-dimer.eng
#dump            1 all custom 1 01WaterWater100-dimer.lammpstrj id type xu yu zu sx sy sz q
#dump_modify     1 sort id
#thermo_style    custom step temp etotal pe ke v_eb v_ew v_ehb v_elp v_ev v_epqeq press pxx pyy pzz pxy pxz pyz
#thermo_modify	line multi
#run             0 #1ns
#undump          1

variable totq equal q[1]+q[2]+q[3]
variable toten equal v_ew+v_ehb+v_elp+v_epqeq
log             ${sname}.eng
thermo          1
thermo_style    custom step temp etotal pe ke v_eb v_ew v_ehb v_elp v_ev v_epqeq v_totq v_toten
thermo_modify   line multi

variable        a loop 27 #21 + 16 
label           loop
run             0
group           water1 id 4 5 6
displace_atoms  water1 rotate -0.066999	0.000000	1.494350 0.892785551	-1.42842E-07	0.039650027 5

next a
jump scan2.in loop


